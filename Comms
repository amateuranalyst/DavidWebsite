<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Versigent Analytics – Team Transition</title>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">
<style>
  /* === VERSIGENT BRAND TOKENS === */
  :root {
    --packard-blue:   #16283F;
    --electric-blue:  #0857C3;
    --sky-blue:       #74D2E7;
    --copper:         #CD7925;
    --molten-gold:    #F7A900;
    --neon-green:     #79DD05;
    --warm-white:     #FBFAF6;
    --light-sienna:   #CB9552;
    --forest-green:   #004624;
    --aluminum-1:     #F1F1F1;
    --aluminum-2:     #888B8D;
    --black:          #000000;
    --white:          #FFFFFF;
  }

  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  body {
    background: var(--aluminum-1);
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 48px 20px;
    font-family: 'Inter', sans-serif;
  }

  .banner {
    width: 100%;
    max-width: 800px;
    background: var(--white);
    border-radius: 4px;
    overflow: hidden;
    box-shadow: 0 8px 48px rgba(22,40,63,0.14);
    animation: fadeUp 0.7s ease both;
  }

  @keyframes fadeUp {
    from { opacity: 0; transform: translateY(24px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  /* === HERO — Packard Blue + Copper gradient === */
  .hero {
    background: linear-gradient(135deg, var(--packard-blue) 0%, #1e3a5c 60%, #0d2035 100%);
    padding: 52px 52px 44px;
    position: relative;
    overflow: hidden;
  }

  /* Copper gradient orb — brand graphic accent */
  .hero::before {
    content: '';
    position: absolute;
    top: -80px; right: -80px;
    width: 360px; height: 360px;
    background: radial-gradient(circle at 60% 40%, rgba(205,121,37,0.28) 0%, rgba(247,169,0,0.12) 40%, transparent 70%);
    border-radius: 50%;
    pointer-events: none;
  }

  /* Sky blue accent bottom-left */
  .hero::after {
    content: '';
    position: absolute;
    bottom: -60px; left: -40px;
    width: 260px; height: 260px;
    background: radial-gradient(circle, rgba(116,210,231,0.08) 0%, transparent 70%);
    border-radius: 50%;
    pointer-events: none;
  }

  .cables {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    overflow: hidden;
  }

  .cables svg {
    position: absolute;
    bottom: -10px;
    right: -20px;
    width: 72%;
    height: 110%;
    opacity: 0.18;
  }

  .cable-path {
    fill: none;
    stroke-linecap: round;
    animation: cableShimmer 6s ease-in-out infinite alternate;
  }

  @keyframes cableShimmer {
    0%   { opacity: 0.7; }
    100% { opacity: 1; }
  }

  .cable-path:nth-child(1)  { animation-delay: 0s; }
  .cable-path:nth-child(2)  { animation-delay: 0.3s; }
  .cable-path:nth-child(3)  { animation-delay: 0.6s; }
  .cable-path:nth-child(4)  { animation-delay: 0.9s; }
  .cable-path:nth-child(5)  { animation-delay: 1.2s; }
  .cable-path:nth-child(6)  { animation-delay: 1.5s; }
  .cable-path:nth-child(7)  { animation-delay: 1.8s; }
  .cable-path:nth-child(8)  { animation-delay: 2.1s; }
  .cable-path:nth-child(9)  { animation-delay: 2.4s; }
  .cable-path:nth-child(10) { animation-delay: 2.7s; }

  /* Copper top-border line */
  .copper-line {
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 4px;
    background: linear-gradient(90deg, var(--copper), var(--molten-gold), var(--copper));
  }

  .badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: rgba(116,210,231,0.12);
    border: 1px solid rgba(116,210,231,0.3);
    border-radius: 2px;
    padding: 5px 14px;
    margin-bottom: 28px;
    animation: fadeUp 0.7s 0.1s ease both;
  }

  .badge-dot {
    width: 6px; height: 6px;
    background: var(--sky-blue);
    border-radius: 50%;
    animation: pulse 2s infinite;
  }

  @keyframes pulse {
    0%,100% { opacity:1; transform:scale(1); }
    50%      { opacity:0.4; transform:scale(0.75); }
  }

  .badge span {
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--sky-blue);
  }

  .hero-eyebrow {
    font-size: 13px;
    font-weight: 400;
    color: rgba(255,255,255,0.5);
    margin-bottom: 10px;
    animation: fadeUp 0.7s 0.15s ease both;
  }

  .hero h1 {
    font-family: 'Inter', sans-serif;
    font-size: 36px;
    font-weight: 300;
    color: var(--white);
    line-height: 1.15;
    margin-bottom: 20px;
    letter-spacing: -0.02em;
    animation: fadeUp 0.7s 0.2s ease both;
  }

  .hero h1 strong {
    font-weight: 600;
    color: var(--sky-blue);
  }

  .hero-body {
    font-size: 14.5px;
    font-weight: 300;
    color: rgba(255,255,255,0.65);
    line-height: 1.75;
    max-width: 540px;
    animation: fadeUp 0.7s 0.25s ease both;
  }

  .hero-body b {
    font-weight: 500;
    color: rgba(255,255,255,0.88);
  }

  .copper-highlight {
    color: var(--molten-gold);
    font-weight: 500;
  }

  /* === COPPER DIVIDER === */
  .copper-divider {
    height: 2px;
    background: linear-gradient(90deg, var(--copper), var(--molten-gold) 50%, transparent);
  }

  /* === CONTINUITY STRIP === */
  .continuity {
    background: rgba(8,87,195,0.05);
    border-top: 1px solid rgba(8,87,195,0.1);
    border-bottom: 1px solid rgba(8,87,195,0.1);
    padding: 14px 52px;
    display: flex;
    align-items: center;
    gap: 12px;
    animation: fadeUp 0.7s 0.28s ease both;
  }

  .continuity-icon {
    width: 28px; height: 28px;
    border-radius: 50%;
    background: rgba(8,87,195,0.08);
    border: 1px solid rgba(8,87,195,0.18);
    display: flex; align-items: center; justify-content: center;
    flex-shrink: 0;
    font-size: 13px;
    font-weight: 700;
    color: var(--electric-blue);
  }

  .continuity-text {
    font-size: 13px;
    font-weight: 400;
    color: var(--packard-blue);
    line-height: 1.5;
  }

  .continuity-text b {
    font-weight: 600;
  }

  /* === CARDS SECTION === */
  .cards-section {
    padding: 40px 52px;
    background: var(--warm-white);
  }

  .section-label {
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--aluminum-2);
    margin-bottom: 24px;
    padding-bottom: 12px;
    border-bottom: 1px solid var(--aluminum-1);
  }

  .cards {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
  }

  .card {
    background: var(--white);
    border: 1px solid var(--aluminum-1);
    border-left: 3px solid var(--copper);
    border-radius: 2px;
    padding: 20px 20px 20px 18px;
    display: flex;
    gap: 14px;
    align-items: flex-start;
    transition: box-shadow 0.2s, transform 0.2s;
    animation: fadeUp 0.7s ease both;
  }

  .card:nth-child(1) { animation-delay: 0.3s;  border-left-color: var(--copper); }
  .card:nth-child(2) { animation-delay: 0.38s; border-left-color: var(--electric-blue); }
  .card:nth-child(3) { animation-delay: 0.46s; border-left-color: var(--molten-gold); }
  .card:nth-child(4) { animation-delay: 0.54s; border-left-color: var(--sky-blue); }

  .card:hover {
    box-shadow: 0 4px 20px rgba(22,40,63,0.09);
    transform: translateY(-2px);
  }

  .card-icon {
    width: 36px; height: 36px;
    border-radius: 2px;
    display: flex; align-items: center; justify-content: center;
    font-size: 16px;
    flex-shrink: 0;
    background: var(--aluminum-1);
  }

  .card-title {
    font-size: 11px;
    font-weight: 600;
    color: var(--packard-blue);
    margin-bottom: 5px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .card-desc {
    font-size: 12.5px;
    font-weight: 300;
    color: var(--aluminum-2);
    line-height: 1.55;
    margin-bottom: 10px;
  }

  .card-link {
    display: inline-block;
    font-size: 12px;
    font-weight: 500;
    color: var(--electric-blue);
    text-decoration: none;
    border-bottom: 1px solid rgba(8,87,195,0.25);
    padding-bottom: 1px;
    transition: color 0.2s, border-color 0.2s;
    word-break: break-all;
  }

  .card-link:hover {
    color: var(--copper);
    border-color: rgba(205,121,37,0.4);
  }

  /* === ALERT === */
  .alert-wrap {
    padding: 0 52px 36px;
    background: var(--warm-white);
    animation: fadeUp 0.7s 0.6s ease both;
  }

  .alert {
    background: rgba(247,169,0,0.06);
    border: 1px solid rgba(205,121,37,0.22);
    border-left: 3px solid var(--copper);
    border-radius: 2px;
    padding: 14px 18px;
    display: flex;
    gap: 12px;
    align-items: flex-start;
  }

  .alert-icon { font-size: 15px; flex-shrink: 0; margin-top: 1px; }

  .alert-text {
    font-size: 13px;
    font-weight: 300;
    color: #4a4a4a;
    line-height: 1.65;
  }

  .alert-text strong {
    font-weight: 600;
    color: var(--copper);
  }

  /* === FOOTER === */
  .footer {
    background: var(--packard-blue);
    padding: 24px 52px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    animation: fadeUp 0.7s 0.65s ease both;
  }

  .sender-name {
    font-size: 14px;
    font-weight: 600;
    color: var(--white);
    letter-spacing: 0.01em;
  }

  .sender-role {
    font-size: 12px;
    font-weight: 300;
    color: rgba(255,255,255,0.5);
    margin-top: 2px;
  }

  .sender-team {
    font-size: 10px;
    font-weight: 500;
    color: var(--sky-blue);
    margin-top: 4px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .logo-mark {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 4px;
  }

  .logo-wordmark {
    font-size: 18px;
    font-weight: 300;
    color: var(--white);
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .logo-wordmark span {
    color: var(--copper);
    font-weight: 600;
  }

  .logo-sub {
    font-size: 9px;
    font-weight: 400;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: rgba(255,255,255,0.3);
  }

  .footer {
    position: relative;
    overflow: hidden;
  }

  .footer-cables {
    position: absolute;
    inset: 0;
    pointer-events: none;
    overflow: hidden;
  }

  .footer-cables svg {
    position: absolute;
    top: -10px;
    left: -20px;
    width: 75%;
    height: 130%;
    opacity: 0.12;
  }

  .footer-content {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
  }

  @media (max-width: 580px) {
    .hero, .cards-section, .alert-wrap, .footer { padding-left: 24px; padding-right: 24px; }
    .cards { grid-template-columns: 1fr; }
    .hero h1 { font-size: 26px; }
    .footer { flex-direction: column; gap: 20px; align-items: flex-start; }
    .logo-mark { align-items: flex-start; }
  }
</style>
</head>
