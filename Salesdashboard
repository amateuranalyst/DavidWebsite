const REGION_COLORS = { NA: “#2563EB”, EMEA: “#059669”, APAC: “#D97706”, LATAM: “#7C3AED” };
const CAT_COLORS = [”#2563EB”,”#059669”,”#D97706”,”#7C3AED”,”#DC2626”];

// ─── Helpers ─────────────────────────────────────────────────────────────────
const fmt = (n) => n >= 1e6 ? `$${(n/1e6).toFixed(2)}M` : n >= 1e3 ? `$${(n/1e3).toFixed(1)}K` : `$${n.toFixed(0)}`;
const fmtNum = (n) => n >= 1e3 ? `${(n/1e3).toFixed(1)}K` : n.toString();

