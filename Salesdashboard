if (!map[key][d.region]) map[key][d.region] = 0;
map[key][d.region] += d.revenue;
});
return Object.values(map).sort((a,b) => a.period.localeCompare(b.period))
.map(d => {
const r = { period: d.period };
REGIONS.forEach(reg => r[reg] = parseFloat((d[reg] || 0).toFixed(0)));
return r;
