// ─── Seed Data ───────────────────────────────────────────────────────────────
const REGIONS = [“NA”, “EMEA”, “APAC”, “LATAM”];
const CATEGORIES = [“Sensors”, “Actuators”, “Controllers”, “Connectors”, “Cables”];
const CUSTOMERS = [
“Aerotek Systems”, “BridgeCore Inc”, “Cortex Dynamics”, “DeltaForge Ltd”,
“Envision Technologies”, “FusionWorks”, “GridLine Co”, “HorizonTech”,
“IntelliParts”, “JetStream LLC”
];
const PARTS = [
“VRG-1001”, “VRG-1042”, “VRG-2201”, “VRG-2345”, “VRG-3010”,
“VRG-3312”, “VRG-4400”, “VRG-4512”, “VRG-5001”, “VRG-5220”
];

function seededRand(seed) {
let s = seed;
return () => { s = (s * 16807 + 0) % 2147483647; return (s - 1) / 2147483646; };
}

function generateInvoices() {
const r = seededRand(42);
const invoices = [];
let id = 1000;
for (let year = 2024; year <= 2025; year++) {
for (let month = 1; month <= 12; month++) {
const count = Math.floor(r() * 60) + 40;
for (let i = 0; i < count; i++) {
const region = REGIONS[Math.floor(r() * REGIONS.length)];
const cat = CATEGORIES[Math.floor(r() * CATEGORIES.length)];
const part = PARTS[Math.floor(r() * PARTS.length)];
const customer = CUSTOMERS[Math.floor(r() * CUSTOMERS.length)];
const units = Math.floor(r() * 200) + 10;
const price = parseFloat((r() * 900 + 100).toFixed(2));
invoices.push({
id: `INV-${id++}`,
date: new Date(year, month - 1, Math.floor(r() * 28) + 1),
year, month,
quarter: `Q${Math.ceil(month / 3)}`,
region, category: cat, partNumber: part, customer,
units, unitPrice: price,
revenue: parseFloat((units * price).toFixed(2))
});
}
}
}
return invoices;
}

const ALL_INVOICES = generateInvoices();

