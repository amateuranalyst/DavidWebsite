map[d.category].revenue += d.revenue;
});
return Object.values(map).map(d => ({ …d, revenue: parseFloat(d.revenue.toFixed(0)) }))
.sort((a,b) => b.revenue - a.revenue);
}, [filtered]);

// Regional time series
const regionalTimeSeries = useMemo(() => {
const map = {};
