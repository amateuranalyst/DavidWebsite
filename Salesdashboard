const [yearFilter, setYearFilter] = useState(“all”);
const [activeTab, setActiveTab] = useState(“overview”);

const filtered = useMemo(() => {
if (yearFilter === “all”) return ALL_INVOICES;
return ALL_INVOICES.filter(d => d.year === parseInt(yearFilter));
}, [yearFilter]);

// KPIs
const kpis = useMemo(() => {
const revenue = filtered.reduce((s, d) => s + d.revenue, 0);
const units = filtered.reduce((s, d) => s + d.units, 0);
const invoices = filtered.length;
const customers = new Set(filtered.map(d => d.customer)).size;
const avgDeal = revenue / invoices;
return { revenue, units, invoices, customers, avgDeal };
}, [filtered]);

// Time series
const timeSeries = useMemo(() => {
const map = {};
filtered.forEach(d => {
let key;
if (timeView === “monthly”) key = `${d.year}-${String(d.month).padStart(2,"0")}`;
else if (timeView === “quarterly”) key = `${d.year} ${d.quarter}`;
else key = String(d.year);
if (!map[key]) map[key] = { period: key, revenue: 0, units: 0, invoices: 0 };
map[key].revenue += d.revenue;
map[key].units += d.units;
map[key].invoices += 1;
});
return Object.values(map).sort((a,b) => a.period.localeCompare(b.period))
.map(d => ({ …d, revenue: parseFloat(d.revenue.toFixed(0)) }));
}, [filtered, timeView]);

// Regional
const regionalData = useMemo(() => {
const map = {};
filtered.forEach(d => {
if (!map[d.region]) map[d.region] = { region: d.region, revenue: 0, units: 0, customers: new Set() };
map[d.region].revenue += d.revenue;
map[d.region].units += d.units;
map[d.region].customers.add(d.customer);
});
return Object.values(map).map(d => ({
…d, revenue: parseFloat(d.revenue.toFixed(0)), customers: d.customers.size
})).sort((a,b) => b.revenue - a.revenue);
}, [filtered]);

// Part numbers
